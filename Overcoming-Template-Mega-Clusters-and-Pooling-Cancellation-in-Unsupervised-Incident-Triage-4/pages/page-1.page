  - elementId: paper-figure-five
    elementType: image
    bounds: [1584, 1484, 1800, 563]
    src: media/poster-payoff-final-hires.png
    fit: {mode: contain}
  - elementId: payoff-caption
    elementType: text
    bounds: [1584, 2070, 1800, 78]
    content:
      text: 'Paper Fig. 5. Withheld roles distinguish internal sprints from user bugs (left). Synthetic IT intake logs expose cross-boundary outages left in generic queues or Unassigned (right).'
      fontFamily: Arial
      fontSize: 29
      wrap: true
      margins: [0, 0, 0, 0]
